<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KampusFind — Lost & Found + Nebeng Kampus</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'] },
          colors: {
            deep: '#0b132b',
            panel: '#1c2541',
            panel2: '#243b55',
            cyanx: '#00d4ff',
            emx: '#34d399',
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    html, body { height: 100%; }
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: #0b132b; }

    .glass {
      background: linear-gradient(180deg, rgba(28,37,65,.92), rgba(28,37,65,.78));
      border: 1px solid rgba(148,163,184,.14);
      backdrop-filter: blur(12px);
    }
    .glow-cyan { box-shadow: 0 0 0 1px rgba(0,212,255,.15), 0 10px 40px rgba(0,212,255,.08); }
    .glow-em { box-shadow: 0 0 0 1px rgba(52,211,153,.15), 0 10px 40px rgba(52,211,153,.08); }

    .input-dark {
      background: rgba(11,19,43,.65);
      border: 1px solid rgba(148,163,184,.18);
    }
    .input-dark:focus {
      outline: none;
      border-color: rgba(0,212,255,.55);
      box-shadow: 0 0 0 3px rgba(0,212,255,.12);
    }

    .tab-active {
      background: linear-gradient(135deg, rgba(0,212,255,.18), rgba(52,211,153,.12));
      border-color: rgba(0,212,255,.35);
      color: #e2e8f0;
    }

    .badge-lost { background: rgba(248,113,113,.15); color: #fca5a5; border: 1px solid rgba(248,113,113,.25); }
    .badge-found { background: rgba(52,211,153,.15); color: #6ee7b7; border: 1px solid rgba(52,211,153,.25); }
    .badge-nebeng { background: rgba(0,212,255,.12); color: #67e8f9; border: 1px solid rgba(0,212,255,.25); }

    .scroll-thin::-webkit-scrollbar { width: 8px; height: 8px; }
    .scroll-thin::-webkit-scrollbar-thumb { background: rgba(148,163,184,.25); border-radius: 999px; }

    .fade-in { animation: fadeIn .35s ease both; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    .hidden-strict { display: none !important; }
  </style>
</head>
<body class="h-full text-slate-200 antialiased">
  <!-- ===================== AUTH GATE ===================== -->
  <div id="auth-screen" class="min-h-full flex items-center justify-center p-4 relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-cyan-400/10 blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl"></div>
    </div>

    <div class="w-full max-w-md glass rounded-3xl p-6 sm:p-8 glow-cyan relative z-10 fade-in">
      <div class="text-center mb-7">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-400/20 to-emerald-400/20 border border-cyan-300/20 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12.5l2.2 2.2L15.8 9.6" />
          </svg>
        </div>
        <h1 class="text-2xl font-extrabold tracking-tight text-white">KampusFind</h1>
        <p class="text-sm text-slate-400 mt-1">Lost & Found + Board Nebeng kampus</p>
      </div>

      <!-- LOGIN FORM -->
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Email Kampus</label>
          <input id="login-email" type="email" required placeholder="nama@kampus.ac.id" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Password</label>
          <input id="login-password" type="password" required minlength="6" placeholder="Masukkan password" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <button type="submit" id="login-btn" class="w-full rounded-xl py-3 text-sm font-bold text-deep bg-gradient-to-r from-cyan-300 to-emerald-300 hover:opacity-95 transition active:scale-[.99]">
          Masuk
        </button>
        <p class="text-center text-sm text-slate-400 pt-1">
          Belum punya akun?
          <button type="button" id="to-register" class="text-cyan-300 font-semibold hover:underline">Daftar</button>
        </p>
      </form>

      <!-- REGISTER FORM -->
      <form id="register-form" class="space-y-4 hidden">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Nama Lengkap</label>
          <input id="reg-name" type="text" required placeholder="Nama lengkap" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">NIM</label>
          <input id="reg-nim" type="text" required placeholder="Contoh: 2200018001" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Email Kampus</label>
          <input id="reg-email" type="email" required placeholder="nama@kampus.ac.id" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Password</label>
          <input id="reg-password" type="password" required minlength="6" placeholder="Minimal 6 karakter" class="input-dark w-full rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500" />
        </div>
        <button type="submit" id="register-btn" class="w-full rounded-xl py-3 text-sm font-bold text-deep bg-gradient-to-r from-emerald-300 to-cyan-300 hover:opacity-95 transition active:scale-[.99]">
          Buat Akun
        </button>
        <p class="text-center text-sm text-slate-400 pt-1">
          Sudah punya akun?
          <button type="button" id="to-login" class="text-emerald-300 font-semibold hover:underline">Login</button>
        </p>
      </form>

      <div id="auth-error" class="hidden mt-4 text-sm text-red-300 bg-red-500/10 border border-red-400/20 rounded-xl px-3 py-2"></div>
      <div id="auth-loading" class="hidden mt-4 text-center text-xs text-slate-400">Memproses...</div>
    </div>
  </div>

  <!-- ===================== MAIN APP ===================== -->
  <div id="app-screen" class="hidden-strict min-h-full flex flex-col">
    <!-- NAVBAR -->
    <header class="sticky top-0 z-40 border-b border-slate-700/50 bg-[#0b132b]/90 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <button id="nav-profile-btn" onclick="openMyProfile()" class="flex items-center gap-3 min-w-0 text-left hover:opacity-80 transition group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400/25 to-emerald-400/20 border border-cyan-300/30 flex items-center justify-center shrink-0 group-hover:border-cyan-300/60">
            <span id="nav-avatar-initial" class="text-cyan-300 font-extrabold text-sm">KF</span>
          </div>
          <div class="min-w-0">
            <h1 class="text-base sm:text-lg font-extrabold text-white leading-tight flex items-center gap-1.5">
              KampusFind
            </h1>
            <p class="text-[11px] text-slate-400 truncate">Halo, <span id="nav-username" class="text-cyan-300 font-semibold">User</span></p>
          </div>
        </button>

        <button id="logout-btn" class="shrink-0 rounded-xl px-3.5 py-2 text-xs font-bold border border-slate-600/80 bg-panel hover:bg-panel2 text-slate-200 transition">
          Logout
        </button>
      </div>
    </header>

    <!-- TABS -->
    <div class="max-w-6xl mx-auto w-full px-4 pt-5">
      <div class="grid grid-cols-2 gap-2 p-1 rounded-2xl bg-panel/70 border border-slate-700/50">
        <button id="tab-lostfound" class="tab-btn tab-active rounded-xl px-3 py-2.5 text-sm font-bold border border-transparent transition">
          Lost & Found
        </button>
        <button id="tab-nebeng" class="tab-btn rounded-xl px-3 py-2.5 text-sm font-bold border border-transparent text-slate-400 hover:text-slate-200 transition">
          Nebeng Kampus
        </button>
      </div>
    </div>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 py-5">
      <!-- LOST & FOUND PANEL -->
      <section id="panel-lostfound" class="fade-in">
        <div class="grid lg:grid-cols-5 gap-5">
          <div class="lg:col-span-2 glass rounded-2xl p-5 glow-cyan h-fit">
            <h2 class="text-lg font-bold text-white mb-1">Buat Postingan</h2>
            <p class="text-xs text-slate-400 mb-4">Laporkan barang hilang atau ditemukan.</p>
            <form id="lf-form" class="space-y-3">
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Jenis</label>
                <select id="lf-type" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white">
                  <option value="lost">Hilang</option>
                  <option value="found">Ditemukan</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Judul Barang</label>
                <input id="lf-title" required maxlength="80" placeholder="Contoh: Dompet hitam" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Lokasi</label>
                <input id="lf-location" required maxlength="80" placeholder="Contoh: Gedung T3.3" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Deskripsi</label>
                <textarea id="lf-desc" required rows="3" maxlength="400" placeholder="Ciri-ciri barang" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500 resize-y"></textarea>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Kontak (No WA)</label>
                <input id="lf-contact" required maxlength="60" placeholder="08123456789" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
              </div>
              <button type="submit" id="lf-submit-btn" class="w-full rounded-xl py-2.5 text-sm font-bold text-deep bg-gradient-to-r from-cyan-300 to-emerald-300 hover:opacity-95 transition">
                Publikasikan
              </button>
            </form>
          </div>

          <div class="lg:col-span-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
              <div>
                <h2 class="text-lg font-bold text-white">Feed Lost & Found</h2>
              </div>
              <div class="flex gap-2">
                <select id="lf-filter" class="input-dark rounded-xl px-3 py-2 text-xs text-white">
                  <option value="all">Semua</option>
                  <option value="lost">Hilang</option>
                  <option value="found">Ditemukan</option>
                </select>
                <input id="lf-search" type="search" placeholder="Cari..." class="input-dark rounded-xl px-3 py-2 text-xs text-white placeholder:text-slate-500 w-36 sm:w-44" />
              </div>
            </div>
            <div id="lf-list" class="space-y-3 scroll-thin"></div>
            <div id="lf-empty" class="hidden text-center py-16 text-slate-500 text-sm">Belum ada postingan Lost & Found.</div>
          </div>
        </div>
      </section>

      <!-- NEBENG PANEL -->
      <section id="panel-nebeng" class="hidden fade-in">
        <div class="grid lg:grid-cols-5 gap-5">
          <div class="lg:col-span-2 glass rounded-2xl p-5 glow-em h-fit">
            <h2 class="text-lg font-bold text-white mb-1">Posting Nebeng</h2>
            <p class="text-xs text-slate-400 mb-4">Tawarkan atau cari tumpangan.</p>
            <form id="nb-form" class="space-y-3">
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Tipe</label>
                <select id="nb-type" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white">
                  <option value="offer">Nawarin tumpangan</option>
                  <option value="need">Cari tumpangan</option>
                </select>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Dari</label>
                  <input id="nb-from" required maxlength="50" placeholder="Asal" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Ke</label>
                  <input id="nb-to" required maxlength="50" placeholder="Tujuan" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Tanggal</label>
                  <input id="nb-date" type="date" required class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-400 mb-1">Jam</label>
                  <input id="nb-time" type="time" required class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Kursi / Catatan</label>
                <input id="nb-note" maxlength="120" placeholder="Contoh: 2 kursi, lewat tol" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1">Kontak (No WA)</label>
                <input id="nb-contact" required maxlength="60" placeholder="08123456789" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
              </div>
              <button type="submit" id="nb-submit-btn" class="w-full rounded-xl py-2.5 text-sm font-bold text-deep bg-gradient-to-r from-emerald-300 to-cyan-300 hover:opacity-95 transition">
                Publikasikan
              </button>
            </form>
          </div>

          <div class="lg:col-span-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
              <div>
                <h2 class="text-lg font-bold text-white">Nebeng Kampus</h2>
              </div>
              <div class="flex gap-2">
                <select id="nb-filter" class="input-dark rounded-xl px-3 py-2 text-xs text-white">
                  <option value="all">Semua</option>
                  <option value="offer">Nawarin</option>
                  <option value="need">Cari</option>
                </select>
                <input id="nb-search" type="search" placeholder="Cari rute..." class="input-dark rounded-xl px-3 py-2 text-xs text-white placeholder:text-slate-500 w-36 sm:w-44" />
              </div>
            </div>
            <div id="nb-list" class="space-y-3"></div>
            <div id="nb-empty" class="hidden text-center py-16 text-slate-500 text-sm">Belum ada postingan nebeng.</div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-slate-800/80 py-4 text-center text-[11px] text-slate-500">
      KampusFind · Fidelia Ping + Ilham Risanjaya
    </footer>
  </div>

  <!-- ===================== MODAL PROFIL MAHASISWA ===================== -->
  <div id="profile-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm fade-in">
    <div class="w-full max-w-md glass rounded-3xl p-6 glow-cyan relative space-y-5 max-h-[90vh] overflow-y-auto scroll-thin">
      <div class="flex items-start justify-between border-b border-slate-700/60 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-400/30 to-emerald-400/20 border border-cyan-300/40 flex items-center justify-center font-bold text-cyan-300 text-lg" id="profile-avatar-icon">
            🎓
          </div>
          <div>
            <h3 id="profile-modal-title" class="text-lg font-bold text-white">Profil Mahasiswa</h3>
            <p id="profile-modal-subtitle" class="text-xs text-slate-400">Biodata Lengkap</p>
          </div>
        </div>
        <button onclick="closeProfileModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition">
          ✕
        </button>
      </div>

      <!-- VIEW MODE -->
      <div id="profile-view-mode" class="space-y-4">
        <div class="bg-panel/60 border border-slate-700/50 rounded-2xl p-4 space-y-3">
          <div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Nama Lengkap</span>
            <p id="view-prof-name" class="text-base font-bold text-white leading-tight">-</p>
            <p id="view-prof-nim" class="text-xs font-semibold text-cyan-300 font-mono mt-0.5">NIM: -</p>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-700/40">
            <div>
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Program Studi</span>
              <p id="view-prof-prodi" class="text-sm font-semibold text-cyan-300">-</p>
            </div>
            <div>
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Angkatan</span>
              <p id="view-prof-angkatan" class="text-sm font-semibold text-emerald-300">-</p>
            </div>
          </div>
          <div class="pt-2 border-t border-slate-700/40">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Email Kampus</span>
            <p id="view-prof-email" class="text-xs text-slate-300 font-mono">-</p>
          </div>
          <div class="pt-2 border-t border-slate-700/40">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Bio / Tentang</span>
            <p id="view-prof-bio" class="text-xs text-slate-300 leading-relaxed italic">-</p>
          </div>
        </div>

        <div class="flex gap-2">
          <button id="btn-edit-profile-trigger" onclick="switchProfileToEditMode()" class="hidden w-full rounded-xl py-2.5 text-xs font-bold text-deep bg-gradient-to-r from-cyan-300 to-emerald-300 hover:opacity-95 transition">
            ✏️ Edit Biodata Saya
          </button>
          <a id="btn-wa-profile-trigger" href="#" target="_blank" class="hidden w-full rounded-xl py-2.5 text-xs font-bold text-center text-deep bg-emerald-300 hover:bg-emerald-400 transition">
            💬 Hubungi via WhatsApp
          </a>
        </div>
      </div>

      <!-- EDIT MODE -->
      <form id="profile-edit-form" class="hidden space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Nama Lengkap</label>
            <input id="edit-prof-name" type="text" required class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">NIM</label>
            <input id="edit-prof-nim" type="text" placeholder="2200018001" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Program Studi</label>
            <input id="edit-prof-prodi" type="text" placeholder="Informatika" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Angkatan</label>
            <input id="edit-prof-angkatan" type="text" placeholder="2023" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Nomor WhatsApp</label>
          <input id="edit-prof-phone" type="text" placeholder="08123456789" class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Bio / Status</label>
          <textarea id="edit-prof-bio" rows="2" maxlength="150" placeholder="Anak TI, suka ngopi..." class="input-dark w-full rounded-xl px-3 py-2.5 text-sm text-white placeholder:text-slate-500 resize-none"></textarea>
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="cancelProfileEdit()" class="flex-1 rounded-xl py-2.5 text-xs font-bold border border-slate-600 bg-panel hover:bg-panel2 text-slate-300 transition">
            Batal
          </button>
          <button type="submit" id="btn-save-profile" class="flex-1 rounded-xl py-2.5 text-xs font-bold text-deep bg-gradient-to-r from-cyan-300 to-emerald-300 hover:opacity-95 transition">
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================== MODAL KONFIRMASI HAPUS ===================== -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm fade-in">
    <div class="w-full max-w-sm glass rounded-2xl p-6 glow-cyan text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-red-500/20 text-red-400 mx-auto flex items-center justify-center text-xl font-bold border border-red-500/30">

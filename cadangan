    // ============================================================
    // Realtime Engine
    // ============================================================
    async function teardownRealtime() {
      if (!supabaseClient) return;
      if (lfChannel) await supabaseClient.removeChannel(lfChannel);
      if (nbChannel) await supabaseClient.removeChannel(nbChannel);
      lfChannel = null;
      nbChannel = null;
      lfPosts = [];
      nbPosts = [];
    }

    async function initRealtime() {
      if (!supabaseClient) return;
      await teardownRealtime();
      await Promise.all([fetchLF(), fetchNB()]);

      subscribeLF();
      subscribeNB();
    }

    // ---------- Lost & Found Data ----------
    async function fetchLF() {
      if (!supabaseClient) return;
      const { data, error } = await supabaseClient
        .from('lostfound')
        .select('*')
        .order('created_at', { ascending: false });
      if (error) { console.error('LF Fetch error:', error.message); return; }
      lfPosts = data || [];
      renderLF();
    }

    function subscribeLF() {
      if (!supabaseClient) return;
      lfChannel = supabaseClient.channel('lostfound-changes')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'lostfound' }, (payload) => {
          if (!lfPosts.some(p => p.id === payload.new.id)) {
            lfPosts = [payload.new, ...lfPosts];
            renderLF();
          }
        })
        .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'lostfound' }, (payload) => {
          lfPosts = lfPosts.map(p => p.id === payload.new.id ? payload.new : p);
          renderLF();
        })
        .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'lostfound' }, (payload) => {
          lfPosts = lfPosts.filter(p => p.id !== payload.old.id);
          renderLF();
        })
        .subscribe();
    }

    // ---------- Board Nebeng Data ----------
    async function fetchNB() {
      if (!supabaseClient) return;
      const { data, error } = await supabaseClient
        .from('nebeng')
        .select('*')
        .order('created_at', { ascending: false });
      if (error) { console.error('NB Fetch error:', error.message); return; }
      nbPosts = data || [];
      renderNB();
    }

    function subscribeNB() {
      if (!supabaseClient) return;
      nbChannel = supabaseClient.channel('nebeng-changes')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'nebeng' }, (payload) => {
          if (!nbPosts.some(p => p.id === payload.new.id)) {
            nbPosts = [payload.new, ...nbPosts];
            renderNB();
          }
        })
        .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'nebeng' }, (payload) => {
          nbPosts = nbPosts.map(p => p.id === payload.new.id ? payload.new : p);
          renderNB();
        })
        .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'nebeng' }, (payload) => {
          nbPosts = nbPosts.filter(p => p.id !== payload.old.id);
          renderNB();
        })
        .subscribe();
    }

    // ============================================================
    // Lost & Found CRUD & Event Delegation
    // ============================================================
    document.getElementById('lf-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentUser || !supabaseClient) return;

      const submitBtn = document.getElementById('lf-submit-btn');
      submitBtn.disabled = true;

      const payload = {
        type: document.getElementById('lf-type').value,
        title: document.getElementById('lf-title').value.trim(),
        location: document.getElementById('lf-location').value.trim(),
        desc: document.getElementById('lf-desc').value.trim(),
        contact: document.getElementById('lf-contact').value.trim(),
        user_id: currentUser.uid,
        user_name: currentUser.name
      };

      try {
        const { data, error } = await supabaseClient
          .from('lostfound')
          .insert([payload])
          .select();

        if (error) throw error;

        if (data && data[0] && !lfPosts.some(p => p.id === data[0].id)) {
          lfPosts = [data[0], ...lfPosts];
          renderLF();
        }

        e.target.reset();
        showToast('Postingan berhasil dipublikasikan!');
      } catch (err) {
        showToast('Gagal membuat postingan: ' + err.message, true);
      } finally {
        submitBtn.disabled = false;
      }
    });

    function renderLF() {
      const filter = document.getElementById('lf-filter').value;
      const search = document.getElementById('lf-search').value.toLowerCase();
      const container = document.getElementById('lf-list');
      const empty = document.getElementById('lf-empty');

      const filtered = lfPosts.filter(p => {
        const matchFilter = filter === 'all' || p.type === filter;
        const matchSearch = (p.title || '').toLowerCase().includes(search) ||
                            (p.location || '').toLowerCase().includes(search) ||
                            (p.desc || '').toLowerCase().includes(search);
        return matchFilter && matchSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');

      container.innerHTML = filtered.map(p => {
        const isOwner = currentUser && p.user_id === currentUser.uid;
        const badgeClass = p.type === 'lost' ? 'badge-lost' : 'badge-found';
        const badgeLabel = p.type === 'lost' ? 'Hilang' : 'Ditemukan';

        return `
          <div class="glass rounded-2xl p-4 space-y-2 relative fade-in">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-lg ${badgeClass}">${badgeLabel}</span>
              <span class="text-[10px] text-slate-400">${formatTime(p.created_at)}</span>
            </div>
            <h3 class="font-bold text-white text-base">${escapeHtml(p.title)}</h3>
            <p class="text-xs text-slate-300 font-medium">📍 ${escapeHtml(p.location)}</p>
            <p class="text-xs text-slate-400 leading-relaxed">${escapeHtml(p.desc)}</p>
            <div class="pt-2 border-t border-slate-700/50 flex items-center justify-between gap-2 text-xs">
              <span class="text-slate-400">Oleh: 
                <button data-action="open-profile" data-userid="${p.user_id}" data-username="${escapeHtml(p.user_name || 'Anonim')}" class="text-cyan-300 font-bold hover:underline">
                  ${escapeHtml(p.user_name || 'Anonim')}
                </button>
              </span>
              <div class="flex items-center gap-2">
                <a href="${formatWAUrl(p.contact)}" target="_blank" rel="noopener noreferrer" class="text-cyan-300 font-semibold hover:underline">
                  📞 ${escapeHtml(p.contact)}
                </a>
                ${isOwner ? `<button data-action="delete-post" data-postid="${p.id}" class="text-red-400 hover:text-red-300 font-bold ml-2">Hapus</button>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    document.getElementById('lf-list').addEventListener('click', (e) => {
      const profBtn = e.target.closest('[data-action="open-profile"]');
      if (profBtn) {
        openProfile(profBtn.dataset.userid, profBtn.dataset.username);
        return;
      }
      const delBtn = e.target.closest('[data-action="delete-post"]');
      if (delBtn) {
        promptDelete(delBtn.dataset.postid, 'lostfound');
        return;
      }
    });

    document.getElementById('lf-filter').addEventListener('change', renderLF);
    document.getElementById('lf-search').addEventListener('input', renderLF);

    // ============================================================
    // Board Nebeng CRUD & Event Delegation
    // ============================================================
    document.getElementById('nb-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentUser || !supabaseClient) return;

      const submitBtn = document.getElementById('nb-submit-btn');
      submitBtn.disabled = true;

      const payload = {
        type: document.getElementById('nb-type').value,
        from: document.getElementById('nb-from').value.trim(),
        to: document.getElementById('nb-to').value.trim(),
        date: document.getElementById('nb-date').value,
        time: document.getElementById('nb-time').value,
        note: document.getElementById('nb-note').value.trim(),
        contact: document.getElementById('nb-contact').value.trim(),
        user_id: currentUser.uid,
        user_name: currentUser.name
      };

      try {
        const { data, error } = await supabaseClient
          .from('nebeng')
          .insert([payload])
          .select();

        if (error) throw error;

        if (data && data[0] && !nbPosts.some(p => p.id === data[0].id)) {
          nbPosts = [data[0], ...nbPosts];
          renderNB();
        }

        e.target.reset();
        showToast('Posting nebeng berhasil dipublikasikan!');
      } catch (err) {
        showToast('Gagal posting nebeng: ' + err.message, true);
      } finally {
        submitBtn.disabled = false;
      }
    });

    function renderNB() {
      const filter = document.getElementById('nb-filter').value;
      const search = document.getElementById('nb-search').value.toLowerCase();
      const container = document.getElementById('nb-list');
      const empty = document.getElementById('nb-empty');

      const filtered = nbPosts.filter(p => {
        const matchFilter = filter === 'all' || p.type === filter;
        const matchSearch = (p.from || '').toLowerCase().includes(search) ||
                            (p.to || '').toLowerCase().includes(search) ||
                            (p.note || '').toLowerCase().includes(search);
        return matchFilter && matchSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');

      container.innerHTML = filtered.map(p => {
        const isOwner = currentUser && p.user_id === currentUser.uid;
        const badgeClass = 'badge-nebeng';
        const badgeLabel = p.type === 'offer' ? 'Nawarin Tumpangan' : 'Cari Tumpangan';

        return `
          <div class="glass rounded-2xl p-4 space-y-2 relative fade-in">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-lg ${badgeClass}">${badgeLabel}</span>
              <span class="text-[10px] text-slate-400">${formatTime(p.created_at)}</span>
            </div>
            <h3 class="font-bold text-white text-base">${escapeHtml(p.from)} ➔ ${escapeHtml(p.to)}</h3>
            <p class="text-xs text-slate-300 font-medium">📅 ${escapeHtml(p.date)} · ⏰ ${escapeHtml(p.time)}</p>
            ${p.note ? `<p class="text-xs text-slate-400 leading-relaxed">${escapeHtml(p.note)}</p>` : ''}
            <div class="pt-2 border-t border-slate-700/50 flex items-center justify-between gap-2 text-xs">
              <span class="text-slate-400">Oleh: 
                <button data-action="open-profile" data-userid="${p.user_id}" data-username="${escapeHtml(p.user_name || 'Anonim')}" class="text-emerald-300 font-bold hover:underline">
                  ${escapeHtml(p.user_name || 'Anonim')}
                </button>
              </span>
              <div class="flex items-center gap-2">
                <a href="${formatWAUrl(p.contact)}" target="_blank" rel="noopener noreferrer" class="text-emerald-300 font-semibold hover:underline">
                  📞 ${escapeHtml(p.contact)}
                </a>
                ${isOwner ? `<button data-action="delete-post" data-postid="${p.id}" class="text-red-400 hover:text-red-300 font-bold ml-2">Hapus</button>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    document.getElementById('nb-list').addEventListener('click', (e) => {
      const profBtn = e.target.closest('[data-action="open-profile"]');
      if (profBtn) {
        openProfile(profBtn.dataset.userid, profBtn.dataset.username);
        return;
      }
      const delBtn = e.target.closest('[data-action="delete-post"]');
      if (delBtn) {
        promptDelete(delBtn.dataset.postid, 'nebeng');
        return;
      }
    });

    document.getElementById('nb-filter').addEventListener('change', renderNB);
    document.getElementById('nb-search').addEventListener('input', renderNB);
  </script>
</body>
</html>
      if (/not confirmed/i.test(msg)) return 'Email belum dikonfirmasi. Cek kotak masuk Anda.';
      if (/rate limit/i.test(msg)) return 'Terlalu banyak percobaan. Coba lagi nanti.';
      if (/network|failed to fetch|fetch failed/i.test(msg)) return 'Gagal jaringan. Periksa koneksi Anda.';
      return msg || 'Terjadi kesalahan autentikasi.';
